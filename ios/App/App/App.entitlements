<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (switch to "production" for App Store / TestFlight builds). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links: https://<your domain>/games/... opens in the app.
	     Change the domain with the set-domain script (see README). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:pickup.example.com</string>
	</array>
</dict>
</plist>
