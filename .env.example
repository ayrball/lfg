# Copy to .env.local and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" (legacy) or "publishable" key — safe to expose in the browser
VITE_SUPABASE_KEY=your-anon-or-publishable-key

# Your public website. Share links from the Android/iOS apps point here.
VITE_SITE_URL=https://lfg.example.com

# Public half of the VAPID key pair used for Web Push on the website (see README)
VITE_VAPID_PUBLIC_KEY=

# Set to true once Firebase (Android) and/or APNs (iOS) push is configured (see README)
VITE_NATIVE_PUSH=false

# Optional: store / download links shown on the website's landing page
VITE_ANDROID_URL=
VITE_IOS_URL=
